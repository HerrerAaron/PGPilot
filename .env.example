# DB_HOST: "postgres" for local dev (docker compose --profile local up -d),
# or the RDS endpoint from `terraform output db_endpoint` once provisioned.
DB_HOST=postgres
DB_NAME=taxidb
DB_USER=taxiuser
DB_PASSWORD=changeme
# PGSSLMODE=require when DB_HOST is RDS; omit or leave blank for local Postgres.
PGSSLMODE=

ALERT_EMAIL=your_email@gmail.com
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD="your_gmail_app_password"

# Airflow
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=./airflow
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
# Generate with: python -c "import os, base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
FERNET_KEY=your_generated_fernet_key

# Grafana
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=admin
# GF_DB_SSLMODE: "require" for RDS, "disable" for local Postgres (matches PGSSLMODE above)
GF_DB_SSLMODE=disable
